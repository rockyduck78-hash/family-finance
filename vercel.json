{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/api/index.js" },
    { "source": "/transactions", "destination": "/api/index.js" },
    { "source": "/history", "destination": "/api/index.js" },
    { "source": "/expenses", "destination": "/api/index.js" },
    { "source": "/transfer", "destination": "/api/index.js" },
    { "source": "/family", "destination": "/api/index.js" },
    { "source": "/interbank", "destination": "/api/index.js" },
    { "source": "/doublons", "destination": "/api/index.js" },
    { "source": "/forgot-password", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ]
}
