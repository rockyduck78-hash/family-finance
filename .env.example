# Required
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/family-finance
JWT_SECRET=your-random-secret-here

# Optional (forgot password emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=Family Finance <noreply@familyfinance.app>
